# Copy to .env.local and fill in. Both values are public by design: they reach
# the browser in the built bundle, and what they can do is bounded by row level
# security, not by secrecy. See db/schema.sql and db/submissions.sql.
#
# Never put SUPABASE_SERVICE_ROLE_KEY here, and never give it a VITE_ prefix.
# Anything VITE_ prefixed is inlined into the client bundle. The service role
# key bypasses row level security and belongs in the root .env only.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
